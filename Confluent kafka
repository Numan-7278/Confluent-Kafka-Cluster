>>>> Stopping the cluster 

# On cc 

sudo systemctl stop confluent-control-center prometheus alertmanager 

# On kafka1 

dsh -a sudo systemctl stop confluent-kafka-connect 

dsh -a sudo systemctl stop confluent-schema-registry 

dsh -a sudo systemctl stop confluent-server